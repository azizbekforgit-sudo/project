# Database (Railway provides postgresql://, auto-converted to asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agroverse

# JWT (auto-generated if empty)
SECRET_KEY=

# Admin credentials
ADMIN_PHONE=+998000000000
ADMIN_PASSWORD=admin123

# AI
GROK_API_KEY=

# AI-помощник (Google Gemini). Ключ — только здесь/в настройках сервера, не в коде
GEMINI_API_KEY=

# Вход через Google: OAuth Client ID (тип «Web application») из Google Cloud Console
GOOGLE_CLIENT_ID=

# СМС-коды через Eskiz.uz (вход по СМС и подтверждение номера при регистрации)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Примерные объявления на рынке (false — удалить их)
SEED_DEMO=true
