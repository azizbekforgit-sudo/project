# База данных. Подходит ссылка от Render, Neon или Supabase как есть —
# postgresql:// превращается в asyncpg сам, sslmode/channel_binding обрабатываются в app/database.py
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agroverse

# Ключ для входа в аккаунты. ЗАДАЙТЕ на сервере любую длинную случайную строку:
# если пусто, ключ выводится из DATABASE_URL, и при смене базы всех выкинет из аккаунтов
SECRET_KEY=

# Admin credentials
ADMIN_PHONE=+998000000000
ADMIN_PASSWORD=admin123

# AI
GROK_API_KEY=

# AI-помощник. Ключи — только здесь/в настройках сервера, не в коде.
# Groq (ключ начинается с gsk_) — основной; если он не ответит, используется Gemini
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
GEMINI_API_KEY=

# Вход через Google: OAuth Client ID (тип «Web application») из Google Cloud Console
GOOGLE_CLIENT_ID=

# СМС-коды через Eskiz.uz (вход по СМС и подтверждение номера при регистрации)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Разовая очистка: удалить ВСЕ товары и их фото (выполняется один раз, потом переменную убрать)
# WIPE_PRODUCTS=yes
